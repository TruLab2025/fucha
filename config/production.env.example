# One-time Mac mini deployment profile. Copy this file to:
# ~/.config/fucha24/production.env
# Keep that file mode 0600. It is intentionally not part of Git.

# Confirmed cPanel SSH endpoint. The public key /Users/mini/.ssh/id_ed25519.pub
# must be authorized once for this existing account.
FUCHA_PROD_SSH_HOST=srv3.anyservers.com
FUCHA_PROD_SSH_USER=atilla
FUCHA_PROD_SSH_PORT=2222
FUCHA_PROD_SSH_KEY=/Users/mini/.ssh/id_ed25519

# Existing cPanel Passenger layout. Do not create another Application Root.
FUCHA_PROD_APP_ROOT=/home6/atilla/repositories/Fucha24
FUCHA_PROD_RELEASES_DIR=/home6/atilla/releases/fucha24

# Production smoke test. Basic Auth values stay only in the local profile.
FUCHA_PROD_URL=https://fucha24.pl
FUCHA_PROD_BASIC_AUTH_USER=REPLACE_BASIC_AUTH_USER
FUCHA_PROD_BASIC_AUTH_PASSWORD=REPLACE_BASIC_AUTH_PASSWORD
