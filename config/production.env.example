# One-time Mac mini deployment profile. Copy this file to:
# ~/.config/fucha24/production.env
# Keep that file mode 0600. It is intentionally not part of Git.

# cPanel SSH endpoint. The public key /Users/mini/.ssh/id_ed25519.pub must be
# authorized once for this account in cPanel.
FUCHA_PROD_SSH_HOST=REPLACE_CPanel_SSH_HOST
FUCHA_PROD_SSH_USER=REPLACE_CPanel_SSH_USER
FUCHA_PROD_SSH_PORT=22
FUCHA_PROD_SSH_KEY=/Users/mini/.ssh/id_ed25519

# Absolute paths on the cPanel host. Passenger must point at APP_ROOT/server.js.
FUCHA_PROD_APP_ROOT=REPLACE_ABSOLUTE_CPanel_APP_ROOT
FUCHA_PROD_RELEASES_DIR=REPLACE_ABSOLUTE_CPanel_RELEASES_ROOT

# Production smoke test. Basic Auth values stay only in the local profile.
FUCHA_PROD_URL=https://fucha24.pl
FUCHA_PROD_BASIC_AUTH_USER=REPLACE_BASIC_AUTH_USER
FUCHA_PROD_BASIC_AUTH_PASSWORD=REPLACE_BASIC_AUTH_PASSWORD
