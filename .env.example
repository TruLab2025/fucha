# Storage used by the application
LISTINGS_STORAGE=mysql
MYSQL_HOST=db.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=fucha24
MYSQL_USER=fucha24_app
MYSQL_PASSWORD=replace-with-a-long-password

# Public application address (reserved for the upcoming auth flow)
NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_SECRET=generate-a-long-random-secret-before-enabling-auth

# SMTP: currently used for contact messages and required later for passwordless login
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@app.fucha24.pl
